{
  "name": "mise-manager",
  "version": "1.0.0",
  "description": "Windows 11 风格的 mise 版本管理器桌面应用",
  "author": "caokui <34462958@qq.com>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "screenshot": "electron . --screenshot",
    "build": "electron-builder --win --x64 --publish never",
    "build:nsis": "electron-builder --win nsis --x64 --publish never",
    "build:portable": "electron-builder --win portable --x64 --publish never",
    "build:zip": "electron-builder --win zip --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.misemanager.app",
    "productName": "mise-manager",
    "publish": {
      "provider": "github",
      "owner": "kikock",
      "repo": "mise-manager"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "mise-manager",
      "uninstallDisplayName": "mise-manager",
      "artifactName": "mise-manager-setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "mise-manager-portable-${version}.${ext}"
    },
    "zip": {
      "artifactName": "mise-manager-${version}-win-${arch}.${ext}"
    }
  }
}
