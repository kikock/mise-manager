{
  "name": "mise-manager",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "description": "Windows 11 风格的 mise 版本管理器桌面应用 (Tauri 2.x + Rust 原生底层 + Fluent Design)",
  "author": "caokui <34462958@qq.com>",
  "scripts": {
    "dev": "vite",
    "start": "tauri dev",
    "check:standards": "node ./scripts/check-standards.cjs",
    "build": "npm run check:standards && tsc && vite build",
    "build:clean": "tsc && vite build",
    "build:app": "npm run build && tauri build",
    "build:offline": "npm run build && tauri build --config ./src-tauri/tauri.offline.conf.json",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.6.0",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
